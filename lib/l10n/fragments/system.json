  },
  "system_surfacesBody": {
    "en": "Check Wi-Fi or mobile data. Asset data is cached from the last sync and may be stale.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:856, lib/features/system/system_surfaces.dart:916",
    "zh": "检查 Wi-Fi 或蜂窝数据。资产数据为最后一次同步的缓存，可能已过期。"
  },
  "system_surfacesBody10": {
    "en": "Claims work normally after maintenance; nothing is missed.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1243",
    "zh": "维护结束后可正常领取，不会漏算。"
  },
  "system_surfacesBody11": {
    "en": "LOOP doesn't infer your region from device language, SIM or IP; without an approved decision, it's treated as unknown.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1335",
    "zh": "LOOP 不会从设备语言、SIM 或 IP 推断地区；没有已批准的判定时一律视为未知。"
  },
  "system_surfacesBody12": {
    "en": "Your location isn't inferred, and other features aren't confirmed to be available.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1362",
    "zh": "不推断你所在的位置，也不确认其他功能一定可用。"
  },
  "system_surfacesBody13": {
    "en": "Used for app lock and verification before signing. Biometric data stays with the system; LOOP can't access it.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1465",
    "zh": "用于应用锁与签名前验证。生物特征由系统保管，LOOP 拿不到。"
  },
  "system_surfacesBody14": {
    "en": "Tap a button to show a real toast. It disappears after 2.6 seconds.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1565",
    "zh": "点按钮触发真实 Toast，2.6 秒后自动消失。"
  },
  "system_surfacesBody15": {
    "en": "Normal, identifying and Launch asset share one structure, not one risk judgment. This component appears in chats, community home, market lists and search results, with no route of its own.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1716",
    "zh": "正常、识别中与 Launch 资产共享结构，不共享风险判断。此组件出现在聊天流、社区主页、行情列表、搜索结果四处，不占独立路由。"
  },
  "system_surfacesBody16": {
    "en": "Every item shows its source and time, with no verdict like \"dangerous\" or \"unsafe\". The call is yours.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1728",
    "zh": "每条都标注出处和时间，不给「危险」「不安全」这类结论 —— 判断权留给你。"
  },
  "system_surfacesBody17": {
    "en": "Send, Swap, Launch buys and approvals all go through this one sheet; staking joins only after its own contract plan is approved.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1766",
    "zh": "Send、Swap、Launch 买入、授权全部汇聚到这一个弹层；质押要等独立合约方案批准后才会加入。"
  },
  "system_surfacesBody18": {
    "en": "Your wallet stopped it by your own rule, so the copy says which rule and how to change it, not just \"failed\".",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1814",
    "zh": "是钱包按你的规则挡住了 —— 所以文案要说清是哪条规则、怎么改，而不是只说「失败」。"
  },
  "system_surfacesBody19": {
    "en": "Go back and try again.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1839",
    "zh": "返回上一页后重试。"
  },
  "system_surfacesBody2": {
    "en": "Everything else works. Prices and charts may be off; actions that depend on the current price are paused.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:863",
    "zh": "其他功能正常。价格与图表可能不准，依赖当前价格的动作已暂停。"
  },
  "system_surfacesBody3": {
    "en": "Orders and account changes can't be submitted; market browsing and chat still work.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:870",
    "zh": "订单与账户变更无法提交；行情浏览与聊天仍可使用。"
  },
  "system_surfacesBody4": {
    "en": "Other chains are fine. BSC balances may be off, and trading on that chain is paused.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:931",
    "zh": "其他链正常。BSC 上的资产余额可能不准，该链的交易已暂停。"
  },
  "system_surfacesBody5": {
    "en": "A full outage blocks everything; a single-chain outage should leave other chains working. Blocking it all makes people think the whole app is broken.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:935, lib/features/system/system_surfaces.dart:994",
    "zh": "完全断网时所有操作都要拦；单链故障时其他链应该照常可用 —— 一刀切会让用户以为整个 App 坏了。"
  },
  "system_surfacesBody6": {
    "en": "Per-chain status can't be read right now. This page won't decide for you whether a chain is available.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:982",
    "zh": "暂时读不到单条链的状态，这一页不会替你判断某条链是否可用。"
  },
  "system_surfacesBody7": {
    "en": "Trace ID 7f3a2c9e. Wallet assets stay on-chain, unaffected.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1049",
    "zh": "追踪号 7f3a2c9e，Wallet 资产仍在链上，不受影响。"
  },
  "system_surfacesBody8": {
    "en": "{trace}. Don't assume success or failure; check the latest status before retrying. Wallet assets stay on-chain, unaffected.",
    "placeholders": {
      "trace": {
        "example": "trace == null ? '追踪号未提供' : '追踪号 $trace'",
        "type": "Object"
      }
    },
    "where": "lib/features/system/system_surfaces.dart:1081",
    "zh": "{trace}，不要假定成功或失败；重试前先查看最新状态。Wallet 资产仍在链上，不受影响。"
  },
  "system_surfacesBody9": {
    "en": "LOOP only blocks when an approved version policy requires an update and this version is below its floor.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1136",
    "zh": "只有已批准的版本策略要求更新，并且当前版本低于它的下限时，LOOP 才会拦截。"
  },
  "system_surfacesCaption": {
    "en": "Everything else still works; affected actions stay disabled until recovery.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:954",
    "zh": "其他部分仍可使用；受影响的动作在恢复前保持禁用。"
  },
  "system_surfacesCaption10": {
    "en": "Send, Swap, DApp and Bridge all go through one signing exit.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1758",
    "zh": "发送、兑换、DApp 与跨链统一进入同一签名出口。"
  },
  "system_surfacesCaption11": {
    "en": "LOOP doesn't recognize the requested system page.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1836",
    "zh": "LOOP 无法识别请求的系统页面。"
  },
  "system_surfacesCaption2": {
    "en": "Opening this page doesn't mean this version is unsupported or unsafe.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1125",
    "zh": "打开此页不代表当前版本不受支持或不安全。"
  },
  "system_surfacesCaption3": {
    "en": "An approved version policy requires a supported version. This can't be skipped.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1147",
    "zh": "已批准的版本策略要求受支持的版本，此要求不可跳过。"
  },
  "system_surfacesCaption4": {
    "en": "Opening this page doesn't mean your region or account is restricted.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1324",
    "zh": "打开此页不代表你所在的地区或账号受限。"
  },
  "system_surfacesCaption5": {
    "en": "Assets stay visible read-only; restricted features follow each page's current state.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1350",
    "zh": "资产保持只读可见；受限功能按各自页面的当前状态显示。"
  },
  "system_surfacesCaption6": {
    "en": "Restricted features follow each page's current state; unconfirmed availability isn't listed here.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1351",
    "zh": "受限功能按各自页面的当前状态显示；此页不列出未确认的可用范围。"
  },
  "system_surfacesCaption7": {
    "en": "Camera, notifications and biometrics are asked for only when needed.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1446",
    "zh": "相机、通知和生物识别只在对应动作发生时请求。"
  },
  "system_surfacesCaption8": {
    "en": "Success, warning and error share one position and clear meaning.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1552",
    "zh": "成功、警告与错误共用同一位置和清晰语义。"
  },
  "system_surfacesCaption9": {
    "en": "Lists, details and charts each keep a stable layout so content doesn't jump.",
    "placeholders": {},
    "where": "lib/features/system/system_surfaces.dart:1623",
    "zh": "列表、详情和图表分别保留稳定布局，避免内容跳动。"
  },
  "system_surfacesConnectivitySpecimenCaption": {
