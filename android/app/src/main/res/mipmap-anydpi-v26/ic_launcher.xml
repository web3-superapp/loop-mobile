<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon. The background layer is the flat LOOP Ink plate; the
     foreground layer is the infinity mark on transparency, sized to the 66dp
     Material keyline so neither the launcher mask nor the Android 12+ splash
     mask can clip it. Never bake a plate into the foreground PNG. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
