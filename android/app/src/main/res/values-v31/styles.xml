<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash. The animated icon is the adaptive-icon
         foreground layer, which carries the infinity mark ONLY on transparency:
         any plate baked into the PNG would be cropped into an octagon by the
         system's circular splash mask. The mark therefore sits directly on
         windowSplashScreenBackground, which is the same LOOP Ink as
         launch_background and as the app's first Flutter frame. No
         windowSplashScreenIconBackgroundColor: the brand tile is Ink on Ink. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/loop_ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/loop_ink</item>
    </style>
</resources>
